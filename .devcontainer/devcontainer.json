{
  "name": "telegram-encoder",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y ffmpeg && pip install -r requirements.txt && chmod +x run.sh",
  "secrets": {
    "TELEGRAM_BOT_TOKEN": { "description": "Token de @BotFather" },
    "TELEGRAM_API_ID": { "description": "api_id de my.telegram.org" },
    "TELEGRAM_API_HASH": { "description": "api_hash de my.telegram.org" }
  }
}
